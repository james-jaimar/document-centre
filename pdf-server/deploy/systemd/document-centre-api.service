[Unit]
Description=Document Centre API
After=network.target redis-server.service
Wants=redis-server.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/document-centre-api
EnvironmentFile=/opt/document-centre-api/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/document-centre-api/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5
TimeoutStartSec=60
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
