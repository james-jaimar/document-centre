[Unit]
# DEPRECATED — replaced by document-centre-worker-heavy.service and
# document-centre-worker-light.service. The installer disables this unit
# automatically when the new units are installed. Kept here so existing
# deploys can be cleanly removed.
Description=Document Centre Worker (deprecated single-pool)
After=network.target redis-server.service
Wants=redis-server.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/document-centre-api
EnvironmentFile=/opt/document-centre-api/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/document-centre-api/.venv/bin/celery -A app.worker.celery_app worker -l info -Q default,documents,thumbnails,imposition,pdf
Restart=always
RestartSec=5
TimeoutStartSec=60
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
