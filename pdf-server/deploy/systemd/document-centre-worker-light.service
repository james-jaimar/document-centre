[Unit]
Description=Document Centre Worker (light: default, thumbnails)
After=network.target redis-server.service
Wants=redis-server.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/document-centre-api
EnvironmentFile=/opt/document-centre-api/.env
Environment=PYTHONUNBUFFERED=1
# Ensure the shared PDF handoff cache exists before the worker starts.
# generate_previews reads PDFs from /var/cache/document-centre/pdf-cache
# when the heavy worker has just prepared them, saving the S3 download.
ExecStartPre=/bin/mkdir -p /var/cache/document-centre/pdf-cache
ExecStartPre=/bin/chmod 0775 /var/cache/document-centre/pdf-cache
# 8 prefork children for fast / IO-bound jobs so heavy PDF work cannot
# starve thumbnail and ops queues. inspect_asset + normalize_orientation
# also live on `default` now.
ExecStart=/opt/document-centre-api/.venv/bin/celery -A app.worker.celery_app worker -l info -Q default,thumbnails -n light@%H -P prefork --concurrency=8 --max-tasks-per-child=200 --max-memory-per-child=600000
Restart=always
RestartSec=5
TimeoutStartSec=60
KillSignal=SIGTERM
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
