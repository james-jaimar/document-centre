# Copy to .env and fill in real values. NEVER commit the populated .env.

# --- FastAPI ---------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=https://document-centre-api.jaimar.dev
API_AUTH_TOKEN=change-me-shared-secret-with-edge-proxy

# --- Database (Postgres) ---------------------------------------------------
DATABASE_URL=postgresql+psycopg://user:password@host:5432/document_centre

# --- Redis / Celery broker -------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- S3 (or compatible: Cloudflare R2, Wasabi, MinIO) ---------------------
S3_ENDPOINT_URL=https://s3.eu-west-1.amazonaws.com
S3_REGION=eu-west-1
S3_BUCKET=document-centre-assets
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# --- LibreOffice / office conversion --------------------------------------
SOFFICE_BIN=/usr/bin/soffice
SOFFICE_PROFILE_ROOT=/tmp/lo-profiles
SOFFICE_TIMEOUT_SECONDS=180

# --- Worker tuning --------------------------------------------------------
CELERY_OFFICE_CONCURRENCY=2
CELERY_DEFAULT_CONCURRENCY=4

# --- Logging / observability ----------------------------------------------
LOG_LEVEL=INFO
SENTRY_DSN=

# --- PMP (printmypics) Cloudprinter render offload --------------------
PMP_CLOUDPRINTER_API_KEY=
